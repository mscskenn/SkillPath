YOUTUBE_API_KEY=your_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase CLI local stack (see scripts/setup-sprint4-dev.sh) — run
# `npx supabase status` to get these values for your machine
SUPABASE_PROJECT_REF=your_project_ref_here
SUPABASE_DB_PASSWORD=your_db_password_here
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_ANON_KEY=your_local_anon_key_here
SUPABASE_LOCAL_SERVICE_ROLE_KEY=your_local_service_role_key_here

# Local Supabase CLI Postgres (port 54322, not 5432 — the old plain
# Docker Postgres container was retired in Sprint 4)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
